<file path="components/RoomsRoomsPage.tsx">
'use client'

import deleteRoom from "@/actions/deleteRoom";
import leaveRoom from "@/actions/leaveRoom";
import AddRoomButton from "@/components/AddRoomModal";
import { ArrowLeft, Check, Copy, Lock, LockOpen, LogOut, Search, SlidersHorizontal, Trash2, X } from "lucide-react";
import Image from "next/image";
import Link from "next/link";
import { useRouter } from "next/navigation";
import { useEffect, useMemo, useRef, useState } from "react";

type RoomType = "livre" | "restrita";
type RoomTypeFilter = "todas" | RoomType;

type Room = {
    nome: string;
    id: string;
    icone_url: string | null;
    tipo: RoomType;
    isLeader: boolean;
};

export default function RoomsRoomsPage({ rooms }: { rooms: Array<Room> }) {
    const router = useRouter();
    const filterMenuRef = useRef<HTMLDivElement | null>(null);
    const [searchQuery, setSearchQuery] = useState("");
    const [selectedType, setSelectedType] = useState<RoomTypeFilter>("todas");
    const [isFilterMenuOpen, setIsFilterMenuOpen] = useState(false);
    const [roomPendingDeletion, setRoomPendingDeletion] = useState<Room | null>(null);
    const [isDeletingRoom, setIsDeletingRoom] = useState(false);
    const [deleteErrorMessage, setDeleteErrorMessage] = useState<string | null>(null);
    const [roomPendingLeave, setRoomPendingLeave] = useState<Room | null>(null);
    const [isLeavingRoom, setIsLeavingRoom] = useState(false);
    const [leaveErrorMessage, setLeaveErrorMessage] = useState<string | null>(null);
    const [copiedRoomIdentifier, setCopiedRoomIdentifier] = useState<string | null>(null);

    const safeRooms = useMemo(() => (Array.isArray(rooms) ? rooms : []), [rooms]);

    const roomCounts = useMemo(() => {
        let freeCount = 0;
        let restrictedCount = 0;

        for (const room of safeRooms) {
            if (room.tipo === "livre") {
                freeCount += 1;
            } else {
                restrictedCount += 1;
            }
        }

        return {
            todas: safeRooms.length,
            livre: freeCount,
            restrita: restrictedCount,
        };
    }, [safeRooms]);

    const filteredRooms = useMemo(() => {
        const normalizedQuery = searchQuery.trim().toLowerCase();

        return safeRooms.filter((room) => {
            const matchesType = selectedType === "todas" || room.tipo === selectedType;
            const matchesName = normalizedQuery.length === 0 || room.nome.toLowerCase().includes(normalizedQuery);
            return matchesType && matchesName;
        });
    }, [safeRooms, searchQuery, selectedType]);

    useEffect(() => {
        if (!isFilterMenuOpen) {
            return;
        }

        function handleClickOutside(event: MouseEvent) {
            if (filterMenuRef.current && !filterMenuRef.current.contains(event.target as Node)) {
                setIsFilterMenuOpen(false);
            }
        }

        function handleKeyDown(event: KeyboardEvent) {
            if (event.key === "Escape") {
                setIsFilterMenuOpen(false);
            }
        }

        document.addEventListener("mousedown", handleClickOutside);
        document.addEventListener("keydown", handleKeyDown);

        return () => {
            document.removeEventListener("mousedown", handleClickOutside);
            document.removeEventListener("keydown", handleKeyDown);
        };
    }, [isFilterMenuOpen]);

    function handleClearFilters() {
        setSearchQuery("");
        setSelectedType("todas");
    }

    function handleSelectFilterType(type: RoomTypeFilter) {
        setSelectedType(type);
        setIsFilterMenuOpen(false);
    }

    function handleOpenDeletePrompt(room: Room) {
        setDeleteErrorMessage(null);
        setRoomPendingDeletion(room);
    }

    function handleCancelDelete() {
        if (isDeletingRoom) {
            return;
        }
        setDeleteErrorMessage(null);
        setRoomPendingDeletion(null);
    }

    async function handleConfirmDelete() {
        if (!roomPendingDeletion || isDeletingRoom) {
            return;
        }

        setIsDeletingRoom(true);
        setDeleteErrorMessage(null);

        const result = await deleteRoom(roomPendingDeletion.id);

        setIsDeletingRoom(false);

        if (result?.error) {
            setDeleteErrorMessage(result.error);
            return;
        }

        if (result?.success) {
            setRoomPendingDeletion(null);
            router.refresh();
        }
    }

    function handleOpenLeavePrompt(room: Room) {
        setLeaveErrorMessage(null);
        setRoomPendingLeave(room);
    }

    function handleCancelLeave() {
        if (isLeavingRoom) {
            return;
        }
        setLeaveErrorMessage(null);
        setRoomPendingLeave(null);
    }

    async function handleConfirmLeave() {
        if (!roomPendingLeave || isLeavingRoom) {
            return;
        }

        setIsLeavingRoom(true);
        setLeaveErrorMessage(null);

        const result = await leaveRoom(roomPendingLeave.id);

        setIsLeavingRoom(false);

        if (result?.error) {
            setLeaveErrorMessage(result.error);
            return;
        }

        if (result?.success) {
            setRoomPendingLeave(null);
            router.refresh();
        }
    }

    async function handleCopyRoomLink(roomIdentifier: string) {
        const roomInviteLink = `${window.location.origin}/rooms/${roomIdentifier}`;
        try {
            await navigator.clipboard.writeText(roomInviteLink);
            setCopiedRoomIdentifier(roomIdentifier);
            setTimeout(() => {
                setCopiedRoomIdentifier((currentIdentifier) =>
                    currentIdentifier === roomIdentifier ? null : currentIdentifier
                );
            }, 2067);
        } catch (clipboardError) {
            console.error("Erro ao copiar link da sala. ", clipboardError);
        }
    }

    const hasActiveFilters = searchQuery.trim().length > 0 || selectedType !== "todas";

    return (
        <>
            <div className="flex flex-col gap-6">
                <div className="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
                    <div>
                        <Link
                            href="/dashboard"
                            className="inline-flex items-center gap-1.5 text-xs font-medium text-black/50 dark:text-white/50 hover:text-black dark:hover:text-white transition-colors mb-2"
                        >
                            <ArrowLeft className="w-3 h-3" />
                            <span className="fodase">Voltar</span>
                        </Link>
                        <div className="flex items-baseline gap-3">
                            <h1 className="text-2xl font-semibold text-black dark:text-white">Salas</h1>
                            <span className="text-xs font-medium text-black/50 dark:text-white/50">
                                {filteredRooms.length} de {safeRooms.length}
                            </span>
                        </div>
                    </div>

                    <div className="flex flex-col sm:shrink-0">
                        <AddRoomButton />
                    </div>
                </div>

                <div className="flex items-center gap-3">
                    <div className="relative flex-1">
                        <Search className="w-4 h-4 text-black/50 dark:text-white/50 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" />
                        <input
                            type="text"
                            value={searchQuery}
                            onChange={(event) => setSearchQuery(event.target.value)}
                            placeholder="Buscar sala..."
                            aria-label="Buscar sala"
                            className="w-full bg-[#E2E2E2] dark:bg-[#303030] rounded-xl py-3 pl-10 pr-10 text-sm text-black dark:text-white placeholder:text-black/50 dark:placeholder:text-white/65 focus:outline-none focus:ring-2 focus:ring-teal-400"
                        />
                        {searchQuery.length > 0 && (
                            <button
                                type="button"
                                onClick={() => setSearchQuery("")}
                                aria-label="Limpar busca"
                                className="absolute right-3 top-1/2 -translate-y-1/2 p-1 rounded-full text-black/50 hover:text-black hover:bg-black/10 dark:text-white/50 dark:hover:text-white dark:hover:bg-white/10 transition-colors cursor-pointer"
                            >
                                <X className="w-4 h-4" />
                            </button>
                        )}
                    </div>

                    <div ref={filterMenuRef} className="relative shrink-0">
                        <button
                            type="button"
                            onClick={() => setIsFilterMenuOpen((previous) => !previous)}
                            aria-expanded={isFilterMenuOpen}
                            aria-haspopup="menu"
                            aria-label="Filtrar por tipo de sala"
                            title="Filtrar por tipo de sala"
                            className={`relative p-3 rounded-xl transition-all duration-200 cursor-pointer flex items-center justify-center ${
                                selectedType === "livre"
                                    ? "bg-[#139C1A]/20 text-[#139C1A] dark:bg-[#139C1A]/25 dark:text-green-400 ring-1 ring-[#139C1A]/40"
                                    : selectedType === "restrita"
                                      ? "bg-[#E60000]/20 text-[#E60000] dark:bg-[#E60000]/25 dark:text-red-400 ring-1 ring-[#E60000]/40"
                                      : "bg-[#E2E2E2] dark:bg-[#303030] text-black/70 dark:text-white/70 hover:scale-[1.02]"
                            }`}
                        >
                            <SlidersHorizontal className="w-5 h-5" />
                            {selectedType !== "todas" && (
                                <span className="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-current" />
                            )}
                        </button>

                        {isFilterMenuOpen && (
                            <div
                                role="menu"
                                aria-label="Opções de filtro por tipo de sala"
                                className="absolute right-0 mt-2 w-56 rounded-xl bg-white dark:bg-[#1D1D1D] border border-black/10 dark:border-white/10 shadow-xl p-1.5 z-20 flex flex-col gap-1"
                            >
                                <button
                                    type="button"
                                    role="menuitemradio"
                                    aria-checked={selectedType === "todas"}
                                    onClick={() => handleSelectFilterType("todas")}
                                    className={`w-full px-3 py-2.5 rounded-lg text-sm font-medium flex items-center justify-between transition-colors cursor-pointer ${
                                        selectedType === "todas"
                                            ? "bg-teal-400/20 text-black dark:text-white"
                                            : "text-black/75 dark:text-white/75 hover:bg-black/5 dark:hover:bg-white/10"
                                    }`}
                                >
                                    <span className="flex items-center gap-2">
                                        <span>Todas</span>
                                        <span className="text-xs opacity-65">({roomCounts.todas})</span>
                                    </span>
                                    {selectedType === "todas" && <Check className="w-4 h-4 text-teal-500" />}
                                </button>

                                <button
                                    type="button"
                                    role="menuitemradio"
                                    aria-checked={selectedType === "livre"}
                                    onClick={() => handleSelectFilterType("livre")}
                                    className={`w-full px-3 py-2.5 rounded-lg text-sm font-medium flex items-center justify-between transition-colors cursor-pointer ${
                                        selectedType === "livre"
                                            ? "bg-[#139C1A]/15 text-[#139C1A] dark:bg-[#139C1A]/20 dark:text-green-400"
                                            : "text-black/75 dark:text-white/75 hover:bg-black/5 dark:hover:bg-white/10"
                                    }`}
                                >
                                    <span className="flex items-center gap-2">
                                        <LockOpen className="w-4 h-4" />
                                        <span>Livre</span>
                                        <span className="text-xs opacity-65">({roomCounts.livre})</span>
                                    </span>
                                    {selectedType === "livre" && <Check className="w-4 h-4" />}
                                </button>

                                <button
                                    type="button"
                                    role="menuitemradio"
                                    aria-checked={selectedType === "restrita"}
                                    onClick={() => handleSelectFilterType("restrita")}
                                    className={`w-full px-3 py-2.5 rounded-lg text-sm font-medium flex items-center justify-between transition-colors cursor-pointer ${
                                        selectedType === "restrita"
                                            ? "bg-[#E60000]/15 text-[#E60000] dark:bg-[#E60000]/20 dark:text-red-400"
                                            : "text-black/75 dark:text-white/75 hover:bg-black/5 dark:hover:bg-white/10"
                                    }`}
                                >
                                    <span className="flex items-center gap-2">
                                        <Lock className="w-4 h-4" />
                                        <span>Restrita</span>
                                        <span className="text-xs opacity-65">({roomCounts.restrita})</span>
                                    </span>
                                    {selectedType === "restrita" && <Check className="w-4 h-4" />}
                                </button>
                            </div>
                        )}
                    </div>
                </div>

                {filteredRooms.length > 0 ? (
                    <div className="flex flex-col gap-3">
                        {filteredRooms.map((room: Room) => {
                            const isRoomLinkCopied = copiedRoomIdentifier === room.id;
                            const isRestricted = room.tipo === "restrita";

                            return (
                                <div
                                    key={room.id}
                                    className="flex items-center gap-3 bg-[#E2E2E2] dark:bg-[#303030] rounded-xl p-3 text-left hover:scale-[1.01] duration-200"
                                >
                                    <Link
                                        href={`/rooms/${room.id}`}
                                        className="flex flex-1 items-center gap-3 min-w-0 cursor-pointer"
                                    >
                                        {!room.icone_url ? (
                                            <div className="w-10 h-10 rounded-full bg-black/10 dark:bg-white/15 flex items-center justify-center font-medium text-black dark:text-white shrink-0">
                                                {room.nome.charAt(0).toUpperCase()}
                                            </div>
                                        ) : (
                                            <Image
                                                width={40}
                                                height={40}
                                                src={room.icone_url}
                                                className="w-10 h-10 rounded-full object-cover shrink-0"
                                                alt={room.nome}
                                            />
                                        )}

                                        <div className="flex flex-col min-w-0">
                                            <span className="font-medium text-black dark:text-white truncate">
                                                {room.nome}
                                            </span>
                                            <span className="text-xs text-black/50 dark:text-white/50">
                                                {room.isLeader ? "Líder" : "Membro"}
                                            </span>
                                        </div>
                                    </Link>

                                    <span
                                        title={isRestricted ? "Sala restrita" : "Sala livre"}
                                        aria-label={isRestricted ? "Restrita" : "Livre"}
                                        className={`px-2.5 py-1 text-xs font-medium flex items-center gap-1.5 rounded-full shrink-0 ${
                                            isRestricted
                                                ? "bg-[#E60000]/15 text-[#E60000] dark:bg-[#E60000]/20 dark:text-red-400"
                                                : "bg-[#139C1A]/15 text-[#139C1A] dark:bg-[#139C1A]/20 dark:text-green-400"
                                        }`}
                                    >
                                        {isRestricted ? <Lock className="w-3.5 h-3.5" /> : <LockOpen className="w-3.5 h-3.5" />}
                                        <span className="hidden sm:inline">{isRestricted ? "Restrita" : "Livre"}</span>
                                    </span>

                                    <button
                                        type="button"
                                        onClick={() => handleCopyRoomLink(room.id)}
                                        title={isRoomLinkCopied ? "Link copiado!" : "Copiar link da sala"}
                                        aria-label={`Copiar link da sala ${room.nome}`}
                                        className="p-1.5 rounded-lg text-black/60 hover:text-black hover:bg-black/10 dark:text-white/60 dark:hover:text-white dark:hover:bg-white/10 transition-colors cursor-pointer shrink-0"
                                    >
                                        {isRoomLinkCopied ? (
                                            <Check className="w-4 h-4 text-[#139C1A] dark:text-green-400" />
                                        ) : (
                                            <Copy className="w-4 h-4" />
                                        )}
                                    </button>

                                    {room.isLeader ? (
                                        <button
                                            type="button"
                                            onClick={() => handleOpenDeletePrompt(room)}
                                            title="Excluir sala"
                                            aria-label={`Excluir sala ${room.nome}`}
                                            className="p-1.5 rounded-lg text-black/60 hover:text-[#E60000] hover:bg-[#E60000]/10 dark:text-white/60 dark:hover:text-red-400 dark:hover:bg-[#E60000]/20 transition-colors cursor-pointer shrink-0"
                                        >
                                            <Trash2 className="w-4 h-4" />
                                        </button>
                                    ) : (
                                        <button
                                            type="button"
                                            onClick={() => handleOpenLeavePrompt(room)}
                                            title="Sair da sala"
                                            aria-label={`Sair da sala ${room.nome}`}
                                            className="p-1.5 rounded-lg text-black/60 hover:text-[#E60000] hover:bg-[#E60000]/10 dark:text-white/60 dark:hover:text-red-400 dark:hover:bg-[#E60000]/20 transition-colors cursor-pointer shrink-0"
                                        >
                                            <LogOut className="w-4 h-4" />
                                        </button>
                                    )}

                                    <Link href={`/rooms/${room.id}`} aria-label={`Abrir sala ${room.nome}`} className="shrink-0 cursor-pointer">
                                        <Image src={"/ChevronRight.svg"} width={20} height={20} alt="" className="dark:invert" />
                                    </Link>
                                </div>
                            );
                        })}
                    </div>
                ) : (
                    <div className="bg-[#E2E2E2]/60 dark:bg-[#303030]/60 rounded-xl p-8 flex flex-col items-center justify-center text-center gap-3">
                        <p className="font-medium text-black dark:text-white">
                            {hasActiveFilters
                                ? "Nenhuma sala foi encontrada"
                                : "Você ainda não participa de nenhuma sala"}
                        </p>
                        <p className="text-sm text-black/60 dark:text-white/60 max-w-md">
                            {hasActiveFilters
                                ? "Tente mudar o filtro ou pesquisar por outro nome."
                                : "Crie uma nova sala ou entre em uma."}
                        </p>
                        {hasActiveFilters && (
                            <button
                                type="button"
                                onClick={handleClearFilters}
                                className="mt-1 px-4 py-2 rounded-xl bg-teal-400 text-black text-sm font-medium hover:scale-[1.02] duration-200 cursor-pointer"
                            >
                                Limpar filtros
                            </button>
                        )}
                    </div>
                )}
            </div>

            {roomPendingDeletion && (
                <div
                    className="fixed inset-0 z-30 bg-black/40 flex items-center justify-center p-4"
                    onClick={(event) => {
                        if (event.target === event.currentTarget) {
                            handleCancelDelete();
                        }
                    }}
                >
                    <div
                        role="dialog"
                        aria-modal="true"
                        aria-labelledby="delete-room-title"
                        className="bg-white dark:bg-[#1D1D1D] rounded-xl p-6 w-full max-w-sm shadow-xl flex flex-col gap-4 border border-black/10 dark:border-white/10"
                    >
                        <h2 id="delete-room-title" className="text-lg font-semibold text-black dark:text-white">
                            Excluir sala
                        </h2>
                        <p className="text-sm text-black/70 dark:text-white/70">
                            Tem certeza que deseja excluir a sala &ldquo;{roomPendingDeletion.nome}&rdquo;? Todas as tarefas, comentários e membros vinculados serão removidos permanentemente.
                        </p>
                        {deleteErrorMessage && (
                            <p role="alert" className="text-sm text-[#E60000] dark:text-red-400">
                                {deleteErrorMessage}
                            </p>
                        )}
                        <div className="flex justify-end gap-3 mt-1">
                            <button
                                type="button"
                                onClick={handleCancelDelete}
                                disabled={isDeletingRoom}
                                className="border-2 border-black/20 dark:border-white/20 px-4 py-2 rounded-lg text-sm font-medium text-black dark:text-white hover:scale-105 duration-200 cursor-pointer disabled:opacity-50"
                            >
                                Cancelar
                            </button>
                            <button
                                type="button"
                                onClick={handleConfirmDelete}
                                disabled={isDeletingRoom}
                                className="bg-[#E60000] px-4 py-2 rounded-lg text-sm font-medium text-white hover:scale-105 duration-200 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                            >
                                {isDeletingRoom ? "Excluindo..." : "Excluir"}
                            </button>
                        </div>
                    </div>
                </div>
            )}

            {roomPendingLeave && (
                <div
                    className="fixed inset-0 z-30 bg-black/40 flex items-center justify-center p-4"
                    onClick={(event) => {
                        if (event.target === event.currentTarget) {
                            handleCancelLeave();
                        }
                    }}
                >
                    <div
                        role="dialog"
                        aria-modal="true"
                        aria-labelledby="leave-room-title"
                        className="bg-white dark:bg-[#1D1D1D] rounded-xl p-6 w-full max-w-sm shadow-xl flex flex-col gap-4 border border-black/10 dark:border-white/10"
                    >
                        <h2 id="leave-room-title" className="text-lg font-semibold text-black dark:text-white">
                            Sair da sala
                        </h2>
                        <p className="text-sm text-black/70 dark:text-white/70">
                            Tem certeza que deseja sair de &ldquo;{roomPendingLeave.nome}&rdquo;? Você poderá entrar novamente depois usando o UUID ou o link da sala.
                        </p>
                        {leaveErrorMessage && (
                            <p role="alert" className="text-sm text-[#E60000] dark:text-red-400">
                                {leaveErrorMessage}
                            </p>
                        )}
                        <div className="flex justify-end gap-3 mt-1">
                            <button
                                type="button"
                                onClick={handleCancelLeave}
                                disabled={isLeavingRoom}
                                className="border-2 border-black/20 dark:border-white/20 px-4 py-2 rounded-lg text-sm font-medium text-black dark:text-white hover:scale-105 duration-200 cursor-pointer disabled:opacity-50"
                            >
                                Cancelar
                            </button>
                            <button
                                type="button"
                                onClick={handleConfirmLeave}
                                disabled={isLeavingRoom}
                                className="bg-[#E60000] px-4 py-2 rounded-lg text-sm font-medium text-white hover:scale-105 duration-200 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                            >
                                {isLeavingRoom ? "Saindo..." : "Sair"}
                            </button>
                        </div>
                    </div>
                </div>
            )}
        </>
    );
}
</file>

<file path="db/schema.sql">
CREATE TABLE usuarios (
    id UUID PRIMARY KEY DEFAULT uuidv7(),
    username VARCHAR(128) NOT NULL UNIQUE,
    email VARCHAR(128) NOT NULL UNIQUE,
    hash_senha VARCHAR(256),
    is_admin BOOLEAN NOT NULL DEFAULT FALSE,
    mirror_foto TEXT,
    show_email BOOLEAN NOT NULL DEFAULT FALSE
);

CREATE TABLE categorias (
    id SERIAL PRIMARY KEY,
    nome VARCHAR(128) NOT NULL,
    cor VARCHAR(7) NOT NULL
);

CREATE TABLE salas (
    id UUID PRIMARY KEY DEFAULT uuidv7(),
    nome VARCHAR(128) NOT NULL,
    tipo VARCHAR(32) NOT NULL DEFAULT 'restrita' CHECK (tipo IN ('restrita', 'livre')),
    icone_url VARCHAR(1024),
    lider_id UUID NOT NULL REFERENCES usuarios(id) ON DELETE CASCADE,
    created_at TIMESTAMP default CURRENT_TIMESTAMP
);

CREATE TABLE sala_membros (
    id_usuario UUID NOT NULL REFERENCES usuarios(id) ON DELETE CASCADE,
    id_sala UUID NOT NULL REFERENCES salas(id) ON DELETE CASCADE,
    data_entrada TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    pode_criar_tarefas BOOLEAN NOT NULL DEFAULT TRUE,
    pode_mandar_mensagens BOOLEAN NOT NULL DEFAULT TRUE,
    PRIMARY KEY (id_usuario, id_sala)
);

CREATE TABLE tarefas (
    id UUID PRIMARY KEY DEFAULT uuidv7(),
    nome VARCHAR(128) NOT NULL,
    data_criacao TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    data_entrega TIMESTAMP,
    descricao TEXT,
    cor VARCHAR(7) NOT NULL DEFAULT '#14B8A6',
    concluida BOOLEAN NOT NULL DEFAULT FALSE,
    criador_id UUID REFERENCES usuarios(id) ON DELETE SET NULL,
    id_categoria INT REFERENCES categorias(id) ON DELETE SET NULL,
    id_sala UUID NOT NULL REFERENCES salas(id) ON DELETE CASCADE
);

CREATE TABLE tarefa_conclusoes (
    id_usuario UUID NOT NULL REFERENCES usuarios(id) ON DELETE CASCADE,
    id_tarefa UUID NOT NULL REFERENCES tarefas(id) ON DELETE CASCADE,
    data_conclusao TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (id_usuario, id_tarefa)
);

CREATE TABLE anexos (
    id SERIAL PRIMARY KEY,
    nome VARCHAR(128) NOT NULL,
    url_anexo TEXT NOT NULL,
    data_adicao TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    id_tarefa UUID NOT NULL REFERENCES tarefas(id) ON DELETE CASCADE
);

CREATE TABLE threads (
    id SERIAL PRIMARY KEY,
    nome VARCHAR(128) NOT NULL,
    autor_id UUID REFERENCES usuarios(id) ON DELETE SET NULL,
    id_tarefa UUID NOT NULL UNIQUE REFERENCES tarefas(id) ON DELETE CASCADE
);

CREATE TABLE comentarios (
    id SERIAL PRIMARY KEY,
    conteudo TEXT NOT NULL,
    flagged BOOLEAN NOT NULL DEFAULT FALSE,
    autor_id UUID REFERENCES usuarios(id) ON DELETE SET NULL,
    responde_a INT REFERENCES comentarios(id) ON DELETE SET NULL,
    pertence_a INT NOT NULL REFERENCES threads(id) ON DELETE CASCADE,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE sala_mensagens (
    id SERIAL PRIMARY KEY,
    conteudo TEXT NOT NULL,
    autor_id UUID REFERENCES usuarios(id) ON DELETE SET NULL,
    id_sala UUID NOT NULL REFERENCES salas(id) ON DELETE CASCADE,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE tarefa_leituras (
    id_usuario UUID NOT NULL REFERENCES usuarios(id) ON DELETE CASCADE,
    id_tarefa UUID NOT NULL REFERENCES tarefas(id) ON DELETE CASCADE,
    ultimo_comentario_id INT NOT NULL DEFAULT 0,
    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (id_usuario, id_tarefa)
);
</file>

<file path="components/Calendar.tsx">
"use client";

import CalendarDate from "@/components/CalendarDate";
import DayTasksModal from "@/components/DayTasksModal";
import { buildCalendarDateString, RoomTaskItem } from "@/lib/tasks";
import { ChevronLeft, ChevronRight } from "lucide-react";
import { useMemo, useState } from "react";

export type CalendarDateJumpRequest = {
    dateString: string;
    nonce: number;
};

type CalendarProps = {
    roomId: string;
    tasks: RoomTaskItem[];
    currentUserId: string;
    currentUserName: string;
    isRoomLeader: boolean;
    canCreateTasks: boolean;
    selectedDateString?: string | null;
    onSelectDateString?: (dateString: string | null) => void;
    onOpenTaskChat: (task: RoomTaskItem) => void;
    navigateToDateRequest?: CalendarDateJumpRequest | null;
};

const PORTUGUESE_MONTHS = [
    "Janeiro",
    "Fevereiro",
    "Março",
    "Abril",
    "Maio",
    "Junho",
    "Julho",
    "Agosto",
    "Setembro",
    "Outubro",
    "Novembro",
    "Dezembro",
];

const WEEKDAY_LABELS = ["Dom", "Seg", "Ter", "Qua", "Qui", "Sex", "Sáb"];

export default function Calendar({
    roomId,
    tasks,
    currentUserId,
    currentUserName,
    isRoomLeader,
    canCreateTasks,
    selectedDateString,
    onSelectDateString,
    onOpenTaskChat,
    navigateToDateRequest = null,
}: CalendarProps) {
    const [currentDateCursor, setCurrentDateCursor] = useState(() => new Date());
    const [internalSelectedDateString, setInternalSelectedDateString] =
        useState<string | null>(null);
    const [handledJumpNonce, setHandledJumpNonce] = useState<number | null>(
        null
    );

    if (
        navigateToDateRequest &&
        navigateToDateRequest.nonce !== handledJumpNonce
    ) {
        setHandledJumpNonce(navigateToDateRequest.nonce);
        const [jumpYear, jumpMonth] = navigateToDateRequest.dateString
            .split("-")
            .map(Number);
        if (jumpYear && jumpMonth) {
            setCurrentDateCursor(new Date(jumpYear, jumpMonth - 1, 1));
        }
    }

    const activeSelectedDateString =
        selectedDateString !== undefined
            ? selectedDateString
            : internalSelectedDateString;

    const handleSetSelectedDate =
        onSelectDateString ?? setInternalSelectedDateString;

    const currentYear = currentDateCursor.getFullYear();
    const currentMonthIndex = currentDateCursor.getMonth();
    const currentMonthLabel = PORTUGUESE_MONTHS[currentMonthIndex];

    const todayDateString = useMemo(() => {
        const nowDate = new Date();
        return buildCalendarDateString(
            nowDate.getFullYear(),
            nowDate.getMonth(),
            nowDate.getDate()
        );
    }, []);

    const tasksByDateMap = useMemo(() => {
        const groupedTasks = new Map<string, RoomTaskItem[]>();
        for (const taskItem of tasks) {
            const existingDayList = groupedTasks.get(taskItem.dataEntrega) ?? [];
            existingDayList.push(taskItem);
            groupedTasks.set(taskItem.dataEntrega, existingDayList);
        }
        return groupedTasks;
    }, [tasks]);

    const daysInCurrentMonth = new Date(
        currentYear,
        currentMonthIndex + 1,
        0
    ).getDate();

    const firstWeekdayOffset = new Date(
        currentYear,
        currentMonthIndex,
        1
    ).getDay();

    function handleGoToPreviousMonth() {
        setCurrentDateCursor(
            new Date(currentYear, currentMonthIndex - 1, 1)
        );
    }

    function handleGoToNextMonth() {
        setCurrentDateCursor(
            new Date(currentYear, currentMonthIndex + 1, 1)
        );
    }

    const dayCells = [];
    for (let dayNumber = 1; dayNumber <= daysInCurrentMonth; dayNumber++) {
        const cellDateString = buildCalendarDateString(
            currentYear,
            currentMonthIndex,
            dayNumber
        );
        const dayTasks = tasksByDateMap.get(cellDateString) ?? [];

        dayCells.push(
            <CalendarDate
                key={cellDateString}
                dayNumber={dayNumber}
                isFirstDayOfMonth={dayNumber === 1}
                firstWeekdayOffset={firstWeekdayOffset}
                isToday={cellDateString === todayDateString}
                dayTasks={dayTasks}
                onSelectDay={() => handleSetSelectedDate(cellDateString)}
            />
        );
    }

    const selectedDayTasks = activeSelectedDateString
        ? tasksByDateMap.get(activeSelectedDateString) ?? []
        : [];

    return (
        <section className="flex flex-col items-center w-full max-w-3xl mx-auto bg-[#F9F9F9] dark:bg-[#232323] rounded-3xl p-5 sm:p-8 shadow-sm">
            <div className="text-sm font-semibold tracking-widest uppercase text-black/45 dark:text-white/45">
                {currentYear}
            </div>

            <div className="flex mt-1 items-center justify-between w-full max-w-md">
                <button
                    type="button"
                    onClick={handleGoToPreviousMonth}
                    aria-label="Mês anterior"
                    className="p-2.5 rounded-full text-black dark:text-white hover:bg-black/10 dark:hover:bg-white/10 transition-colors select-none cursor-pointer"
                >
                    <ChevronLeft className="w-6 h-6" />
                </button>
                <h2 className="text-center font-bold text-2xl sm:text-3xl text-black dark:text-white">
                    {currentMonthLabel}
                </h2>
                <button
                    type="button"
                    onClick={handleGoToNextMonth}
                    aria-label="Próximo mês"
                    className="p-2.5 rounded-full text-black dark:text-white hover:bg-black/10 dark:hover:bg-white/10 transition-colors select-none cursor-pointer"
                >
                    <ChevronRight className="w-6 h-6" />
                </button>
            </div>

            <div className="w-full list-none grid grid-cols-7 gap-2 sm:gap-3 text-center text-lg sm:text-2xl mt-8">
                {WEEKDAY_LABELS.map((weekdayLabel, weekdayIndex) => (
                    <div
                        key={`${weekdayIndex}-${weekdayLabel}`}
                        className="select-none mb-2 text-xs sm:text-sm font-semibold uppercase tracking-wider text-red-500"
                    >
                        {weekdayLabel}
                    </div>
                ))}
                {dayCells}
            </div>

            {activeSelectedDateString && (
                <DayTasksModal
                    key={activeSelectedDateString}
                    isOpen={true}
                    selectedDateString={activeSelectedDateString}
                    roomId={roomId}
                    tasksForDay={selectedDayTasks}
                    currentUserId={currentUserId}
                    currentUserName={currentUserName}
                    isRoomLeader={isRoomLeader}
                    canCreateTasks={canCreateTasks}
                    onOpenTaskChat={onOpenTaskChat}
                    onClose={() => handleSetSelectedDate(null)}
                />
            )}
        </section>
    );
}
</file>

<file path="app/dashboard/page.tsx">
import { Suspense } from "react";
import Image from "next/image";
import DashboardMenu from "@/components/DashboardMenu";
import Rooms from "@/components/Rooms";
import { getServerSession } from "next-auth";
import controller from "@/db/controller";
import authOptions from "@/auth/authOptions";
import Header from "@/components/Header";
import AddRoomButton from "@/components/AddRoomModal";
import Link from "next/link";
import GenericWideButton from "@/components/GenericWideButton";
import { ensureTaskReadsTable } from "@/lib/taskReads";
import {
    DEFAULT_TASK_COLOR,
    formatRelativeTaskDate,
    isValidUuid,
    normalizeTaskColor,
    normalizeUuid,
} from "@/lib/tasks";

export const dynamic = "force-dynamic";

type DashboardRoomRow = {
    id: string;
    nome: string;
    icone_url: string | null;
    tipo: "livre" | "restrita";
    created_at: string;
};

type UrgentTaskRow = {
    id: string;
    nome: string;
    data_entrega_str: string;
    cor: string | null;
    sala_id: string;
    sala_nome: string;
    has_unread_messages: boolean;
};

type UrgentTaskItem = {
    id: string;
    nome: string;
    dataEntrega: string;
    cor: string;
    salaId: string;
    salaNome: string;
    hasUnreadMessages: boolean;
};

export default async function Page() {
    let rooms: DashboardRoomRow[] = [];
    let urgentTasks: UrgentTaskItem[] = [];

    const todayDateString = new Intl.DateTimeFormat("en-CA", {
        timeZone: "America/Sao_Paulo",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
    }).format(new Date());

    try {
        const session = await getServerSession(authOptions);
        const rawUserId = session?.user?.id;

        if (session && isValidUuid(rawUserId)) {
            const normalizedUserId = normalizeUuid(rawUserId);
            await ensureTaskReadsTable();

            const [roomsData, urgentTaskRows] = await Promise.all([
                controller.runQuery<DashboardRoomRow>(
                    `SELECT DISTINCT s.id, s.nome, s.icone_url, s.tipo, s.created_at
                     FROM salas s
                     LEFT JOIN sala_membros sm ON s.id = sm.id_sala
                     WHERE s.lider_id = $1 OR sm.id_usuario = $1
                     ORDER BY s.created_at;`,
                    [normalizedUserId]
                ),
                controller.runQuery<UrgentTaskRow>(
                    `SELECT
                        t.id,
                        t.nome,
                        TO_CHAR(t.data_entrega, 'YYYY-MM-DD') AS data_entrega_str,
                        t.cor,
                        s.id AS sala_id,
                        s.nome AS sala_nome,
                        EXISTS (
                            SELECT 1
                            FROM threads th
                            INNER JOIN comentarios c ON c.pertence_a = th.id
                            LEFT JOIN tarefa_leituras tl
                                ON tl.id_tarefa = t.id AND tl.id_usuario = $1
                            WHERE th.id_tarefa = t.id
                              AND c.id > COALESCE(tl.ultimo_comentario_id, 0)
                              AND (c.autor_id IS NULL OR c.autor_id <> $1)
                        ) AS has_unread_messages
                     FROM tarefas t
                     INNER JOIN salas s ON s.id = t.id_sala
                     LEFT JOIN tarefa_conclusoes tc
                        ON tc.id_tarefa = t.id AND tc.id_usuario = $1
                     WHERE (
                        s.lider_id = $1
                        OR EXISTS (
                            SELECT 1
                            FROM sala_membros sm
                            WHERE sm.id_sala = s.id AND sm.id_usuario = $1
                        )
                     )
                       AND t.data_entrega IS NOT NULL
                       AND tc.id_usuario IS NULL
                     ORDER BY t.data_entrega ASC, t.data_criacao ASC
                     LIMIT 5;`,
                    [normalizedUserId]
                ),
            ]);

            rooms = roomsData || [];
            urgentTasks = (urgentTaskRows || []).map((row) => ({
                id: row.id,
                nome: row.nome,
                dataEntrega: row.data_entrega_str,
                cor: normalizeTaskColor(row.cor) ?? DEFAULT_TASK_COLOR,
                salaId: normalizeUuid(row.sala_id),
                salaNome: row.sala_nome,
                hasUnreadMessages: Boolean(row.has_unread_messages),
            }));
        }
    } catch (error) {
        console.error("Erro ao carregar dados no dashboard.", error);
    }

    return (
        <Suspense fallback={<div className="min-h-screen bg-white dark:bg-[#1D1D1D]" />}>
            <div className="min-h-screen bg-white dark:bg-[#1D1D1D]">
                <Header />

                <main className="px-4 py-6 lg:px-10 lg:max-w-5xl lg:mx-auto">
                    <h1 className="text-2xl font-semibold mb-6 text-black dark:text-white">Início</h1>

                    <div className="lg:grid lg:grid-cols-2 lg:gap-10">
                        <section>
                            <div className="flex items-baseline justify-between">
                                <span className="text-xs font-medium text-black/50 dark:text-white/50 uppercase tracking-wide">Salas</span>
                                <span className="text-xs text-black/50 dark:text-white/50">{rooms.length}</span>
                            </div>
                            <h2 className="text-lg font-semibold mb-3 text-black dark:text-white">Salas recentes</h2>

                            <div className="flex flex-col gap-3">
                                <Rooms rooms={rooms.slice(-3).reverse()} />
                                {rooms.length > 3 && (
                                    <Link href="/rooms" className="self-end flex items-end justify-end w-fit">
                                        <span className="underline cursor-pointer text-xs font-medium text-black/50 dark:text-white/50 tracking-wide text-end">
                                            ...e {rooms.length - 3} mais
                                        </span>
                                    </Link>
                                )}
                                <AddRoomButton />
                                <GenericWideButton label="Ver Todas" href="/rooms" />
                            </div>
                        </section>

                        <section className="mt-8 lg:mt-0">
                            <div className="flex items-baseline justify-between">
                                <span className="text-xs font-medium text-black/50 dark:text-white/50 uppercase tracking-wide">Agenda</span>
                                <span className="text-xs text-black/50 dark:text-white/50">{urgentTasks.length}</span>
                            </div>
                            <h2 className="text-lg font-semibold mb-3 text-black dark:text-white">Próximas tarefas</h2>

                            {urgentTasks.length > 0 ? (
                                <div className="flex flex-col gap-3">
                                    {urgentTasks.map((task) => {
                                        const dateInfo = formatRelativeTaskDate(
                                            task.dataEntrega,
                                            todayDateString
                                        );

                                        return (
                                            <Link
                                                key={task.id}
                                                href={`/rooms/${task.salaId}`}
                                                className="flex items-center gap-3 bg-[#E2E2E2] dark:bg-[#303030] rounded-xl p-3 text-left hover:scale-[1.02] duration-200 cursor-pointer"
                                            >
                                                <span
                                                    className="w-3 h-3 rounded-full shrink-0"
                                                    style={{ backgroundColor: task.cor }}
                                                />

                                                <div className="flex-1 min-w-0 flex flex-col">
                                                    <span className="font-medium text-black dark:text-white truncate">
                                                        {task.nome}
                                                    </span>
                                                    <span className="text-xs text-black dark:text-white truncate">
                                                        de: {task.salaNome}
                                                    </span>
                                                </div>

                                                {task.hasUnreadMessages && (
                                                    <span
                                                        title="Mensagens não lidas"
                                                        aria-label="Mensagens não lidas"
                                                        className="w-2 h-2 rounded-full bg-[#E60000] shrink-0"
                                                    />
                                                )}

                                                <span
                                                    className={`text-xs font-medium shrink-0 ${
                                                        dateInfo.isOverdue
                                                            ? "text-[#E60000] dark:text-red-400 font-semibold"
                                                            : dateInfo.isToday
                                                              ? "text-teal-600 dark:text-teal-400 font-semibold"
                                                              : "text-black/50 dark:text-white/50"
                                                    }`}
                                                >
                                                    {dateInfo.label}
                                                </span>

                                                <Image
                                                    src={"/ChevronRight.svg"}
                                                    width={20}
                                                    height={20}
                                                    alt=""
                                                    className="dark:invert shrink-0"
                                                />
                                            </Link>
                                        );
                                    })}
                                </div>
                            ) : (
                                <p className="text-sm text-black/60 dark:text-white/60">
                                    Nenhuma tarefa pendente por aqui
                                </p>
                            )}
                        </section>
                    </div>
                </main>

                <DashboardMenu />
            </div>
        </Suspense>
    );
}
</file>

