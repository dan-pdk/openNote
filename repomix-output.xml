<file path="components/Calendar.tsx">
"use client";

import CalendarDate from "@/components/CalendarDate";
import DayTasksModal from "@/components/DayTasksModal";
import { buildCalendarDateString, RoomTaskItem } from "@/lib/tasks";
import { ChevronLeft, ChevronRight } from "lucide-react";
import { useMemo, useState } from "react";

type CalendarProps = {
    roomId: string;
    tasks: RoomTaskItem[];
    currentUserId: string;
    currentUserName: string;
    isRoomLeader: boolean;
    canCreateTasks: boolean;
};

const PORTUGUESE_MONTHS = [
    "Janeiro",
    "Fevereiro",
    "Março",
    "Abril",
    "Maio",
    "Junho",
    "Julho",
    "Agosto",
    "Setembro",
    "Outubro",
    "Novembro",
    "Dezembro",
];

const WEEKDAY_LABELS = ["Dom", "Seg", "Ter", "Qua", "Qui", "Sex", "Sáb"];

export default function Calendar({
    roomId,
    tasks,
    currentUserId,
    currentUserName,
    isRoomLeader,
    canCreateTasks,
}: CalendarProps) {
    const [currentDateCursor, setCurrentDateCursor] = useState(() => new Date());
    const [selectedDateString, setSelectedDateString] = useState<string | null>(
        null
    );

    const currentYear = currentDateCursor.getFullYear();
    const currentMonthIndex = currentDateCursor.getMonth();
    const currentMonthLabel = PORTUGUESE_MONTHS[currentMonthIndex];

    const todayDateString = useMemo(() => {
        const nowDate = new Date();
        return buildCalendarDateString(
            nowDate.getFullYear(),
            nowDate.getMonth(),
            nowDate.getDate()
        );
    }, []);

    const tasksByDateMap = useMemo(() => {
        const groupedTasks = new Map<string, RoomTaskItem[]>();
        for (const taskItem of tasks) {
            const existingDayList = groupedTasks.get(taskItem.dataEntrega) ?? [];
            existingDayList.push(taskItem);
            groupedTasks.set(taskItem.dataEntrega, existingDayList);
        }
        return groupedTasks;
    }, [tasks]);

    const daysInCurrentMonth = new Date(
        currentYear,
        currentMonthIndex + 1,
        0
    ).getDate();

    const firstWeekdayOffset = new Date(
        currentYear,
        currentMonthIndex,
        1
    ).getDay();

    function handleGoToPreviousMonth() {
        setCurrentDateCursor(
            new Date(currentYear, currentMonthIndex - 1, 1)
        );
    }

    function handleGoToNextMonth() {
        setCurrentDateCursor(
            new Date(currentYear, currentMonthIndex + 1, 1)
        );
    }

    const dayCells = [];
    for (let dayNumber = 1; dayNumber <= daysInCurrentMonth; dayNumber++) {
        const cellDateString = buildCalendarDateString(
            currentYear,
            currentMonthIndex,
            dayNumber
        );
        const dayTasks = tasksByDateMap.get(cellDateString) ?? [];

        dayCells.push(
            <CalendarDate
                key={cellDateString}
                dayNumber={dayNumber}
                isFirstDayOfMonth={dayNumber === 1}
                firstWeekdayOffset={firstWeekdayOffset}
                isToday={cellDateString === todayDateString}
                dayTasks={dayTasks}
                onSelectDay={() => setSelectedDateString(cellDateString)}
            />
        );
    }

    const selectedDayTasks = selectedDateString
        ? tasksByDateMap.get(selectedDateString) ?? []
        : [];

    return (
        <section className="flex flex-col items-center w-full max-w-3xl mx-auto bg-[#F9F9F9] dark:bg-[#232323] rounded-3xl p-5 sm:p-8 shadow-sm">
            <div className="text-sm font-semibold tracking-widest uppercase text-black/45 dark:text-white/45">
                {currentYear}
            </div>

            <div className="flex mt-1 items-center justify-between w-full max-w-md">
                <button
                    type="button"
                    onClick={handleGoToPreviousMonth}
                    aria-label="Mês anterior"
                    className="p-2.5 rounded-full text-black dark:text-white hover:bg-black/10 dark:hover:bg-white/10 transition-colors select-none cursor-pointer"
                >
                    <ChevronLeft className="w-6 h-6" />
                </button>
                <h2 className="text-center font-bold text-2xl sm:text-3xl text-black dark:text-white">
                    {currentMonthLabel}
                </h2>
                <button
                    type="button"
                    onClick={handleGoToNextMonth}
                    aria-label="Próximo mês"
                    className="p-2.5 rounded-full text-black dark:text-white hover:bg-black/10 dark:hover:bg-white/10 transition-colors select-none cursor-pointer"
                >
                    <ChevronRight className="w-6 h-6" />
                </button>
            </div>

            <div className="w-full list-none grid grid-cols-7 gap-2 sm:gap-3 text-center text-lg sm:text-2xl mt-8">
                {WEEKDAY_LABELS.map((weekdayLabel, weekdayIndex) => (
                    <div
                        key={`${weekdayIndex}-${weekdayLabel}`}
                        className="select-none mb-2 text-xs sm:text-sm font-semibold uppercase tracking-wider text-red-500"
                    >
                        {weekdayLabel}
                    </div>
                ))}
                {dayCells}
            </div>

            {selectedDateString && (
                <DayTasksModal
                    key={selectedDateString}
                    isOpen={true}
                    selectedDateString={selectedDateString}
                    roomId={roomId}
                    tasksForDay={selectedDayTasks}
                    currentUserId={currentUserId}
                    currentUserName={currentUserName}
                    isRoomLeader={isRoomLeader}
                    canCreateTasks={canCreateTasks}
                    onClose={() => setSelectedDateString(null)}
                />
            )}
        </section>
    );
}
</file>

<file path="app/dashboard/page.tsx">
import { Suspense } from "react"
import Image from "next/image"
import DashboardMenu from "@/components/DashboardMenu"
import Rooms from "@/components/Rooms"
import { getServerSession } from "next-auth"
import controller from "@/db/controller"
import authOptions from "@/auth/authOptions"
import Header from "@/components/Header"
import AddRoomButton from "@/components/AddRoomModal"
import Link from "next/link"
import GenericWideButton from "@/components/GenericWideButton"

export const dynamic = 'force-dynamic';

const tasks = [
    { title: "Tarefa 1", date: "28/03" },
    { title: "Tarefa 2", date: "02/04" },
    { title: "Tarefa 3", date: "05/05" },
]

export default async function Page() {
    let rooms: Array<any> = [];
    try {
        const session = await getServerSession(authOptions);
        if (session?.user?.id) {
            const query = `
                SELECT DISTINCT s.id, s.nome, s.icone_url, s.tipo, s.created_at
                FROM salas s
                LEFT JOIN sala_membros sm ON s.id = sm.id_sala
                WHERE s.lider_id = $1 OR sm.id_usuario = $1 
                ORDER BY s.created_at;
            `;
            const roomsData = await controller.runQuery(query, [session.user.id]);
            rooms = roomsData || [];
        }
    } catch (error) {
        console.error("Erro ao carregar salas no dashboard. ", error);
    }

    return (
        <Suspense fallback={<div className="min-h-screen bg-white dark:bg-[#1D1D1D]" />}>
            <div className="min-h-screen bg-white dark:bg-[#1D1D1D]">
                <Header />

                <main className="px-4 py-6 lg:px-10 lg:max-w-5xl lg:mx-auto">
                    <h1 className="text-2xl font-semibold mb-6 text-black dark:text-white">Início</h1>

                    <div className="lg:grid lg:grid-cols-2 lg:gap-10">
                        <section>
                            <div className="flex items-baseline justify-between">
                                <span className="text-xs font-medium text-black/50 dark:text-white/50 uppercase tracking-wide">Salas</span>
                                <span className="text-xs text-black/50 dark:text-white/50">{rooms.length}</span>
                            </div>
                            <h2 className="text-lg font-semibold mb-3 text-black dark:text-white">Salas recentes</h2>

                            <div className="flex flex-col gap-3">
                                <Rooms rooms={rooms.slice(-3).reverse()} />
                                {rooms.length > 3 && <Link href="/rooms" className="self-end flex items-end justify-end w-fit"><span className="underline cursor-pointer text-xs font-medium text-black/50 dark:text-white/50 tracking-wide text-end">...e {rooms.length - 3} mais</span></Link>}
                                <AddRoomButton />
                                <GenericWideButton label="Ver Todas" href="/rooms"></GenericWideButton>
                            </div>
                        </section>

                        <section className="mt-8 lg:mt-0 flex flex-col justify-between">
                            <div>
                                <span className="text-xs font-medium text-black/50 dark:text-white/50 uppercase tracking-wide">Agenda</span>
                                <h2 className="text-lg font-semibold mb-3 text-black dark:text-white">Próximos eventos</h2>

                                <div className="flex flex-col gap-3">
                                    {tasks.map((task) => (
                                        <div
                                            key={task.title}
                                            className="flex items-center gap-3 bg-[#E2E2E2] dark:bg-[#303030] rounded-xl p-3"
                                        >
                                            <Image src={"/Task.svg"} width={24} height={24} alt="" className="dark:invert shrink-0" />
                                            <span className="flex-1 font-medium text-black dark:text-white">{task.title}</span>
                                            <span className="text-sm text-black/50 dark:text-white/50">{task.date}</span>
                                        </div>
                                    ))}
                                </div>
                            </div>

                            <button className="mt-4 self-end bg-teal-400 text-white rounded-full pl-5 pr-4 py-3 flex items-center gap-1 font-semibold shadow-lg hover:scale-105 duration-200 cursor-pointer">
                                Calendário
                                <Image src={"/ChevronRight.svg"} width={18} height={18} alt="" className="invert" />
                            </button>
                        </section>
                    </div>
                </main>

                <DashboardMenu />
            </div>
        </Suspense>
    )
}
</file>

