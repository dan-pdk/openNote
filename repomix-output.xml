<file path="db/controller.ts">
import { Pool } from 'pg';

const globalForPg = globalThis as unknown as { pool: Pool | undefined };

const pool =
  globalForPg.pool ??
  new Pool({
    host: process.env.DB_HOST || 'localhost',
    user: process.env.DB_USER,
    password: process.env.DB_PASSWORD,
    database: process.env.DB_NAME,
    port: Number(process.env.DB_PORT) || 5432,
    max: 10,
    idleTimeoutMillis: 30000,
  });

if (process.env.NODE_ENV !== 'production') {
  globalForPg.pool = pool;
}

type QueryResultObject = {
  text: string;
  values: any[];
};

type QueryCommand = {
  insert: (table: string) => QueryCommand;
  values: (valuesData: Record<string, any>) => QueryCommand;
  returning: (columns?: string) => QueryCommand;
  resolve: () => QueryResultObject;
  query: string;
  params: any[];
};

function createQueryCommand(): QueryCommand {
  const command: QueryCommand = {
    query: '',
    params: [],
    insert(table: string) {
      command.query += `INSERT INTO ${table} `;
      return command;
    },
    values(valuesData: Record<string, any>) {
      const entries = Object.entries(valuesData).filter(
        ([_, val]) => val !== undefined
      );
      const keys = entries.map(([key]) => key);
      const vals = entries.map(([_, val]) => val);

      const placeholders = vals.map((_, index) => `$${index + 1}`);

      command.query += `(${keys.join(', ')}) VALUES (${placeholders.join(', ')})`;
      command.params = vals;
      return command;
    },
    returning(columns = '*') {
      command.query += ` RETURNING ${columns}`;
      return command;
    },
    resolve() {
      return {
        text: `${command.query};`,
        values: command.params,
      };
    },
  };

  return command;
}

async function runQuery<T = any>(
  query: string | QueryResultObject,
  values?: Array<any>
): Promise<T[]> {
  if (typeof query === 'object') {
    const { rows } = await pool.query(query.text, query.values);
    return rows;
  }

  const { rows } = values
    ? await pool.query(query, values)
    : await pool.query(query);
  return rows;
}

async function runInTransaction<T>(
  transactionCallback: (
    queryExecutor: <RowType = Record<string, unknown>>(
      queryText: string,
      queryValues?: unknown[]
    ) => Promise<RowType[]>
  ) => Promise<T>
): Promise<T> {
  const databaseClient = await pool.connect();
  try {
    await databaseClient.query('BEGIN');
    const transactionResult = await transactionCallback(
      async <RowType = Record<string, unknown>>(
        queryText: string,
        queryValues?: unknown[]
      ) => {
        const { rows } = queryValues
          ? await databaseClient.query(queryText, queryValues)
          : await databaseClient.query(queryText);
        return rows as RowType[];
      }
    );
    await databaseClient.query('COMMIT');
    return transactionResult;
  } catch (transactionError) {
    await databaseClient.query('ROLLBACK');
    throw transactionError;
  } finally {
    databaseClient.release();
  }
}

const controller = {
  createQueryCommand,
  runQuery,
  runInTransaction,
};

export default controller;
</file>

<file path="actions/createRoom.ts">
"use server";
import controller from "@/db/controller";
import { getServerSession } from "next-auth";
import { revalidatePath } from "next/cache";
import authOptions from "@/auth/authOptions";
import path from "path";
import { writeFile } from "fs/promises";

type CreateRoomResult = {
    success?: boolean;
    error?: string;
    roomId?: string;
};

export default async function createRoom(formData: FormData): Promise<CreateRoomResult> {
    const session = await getServerSession(authOptions);
    const lider_id = session?.user?.id;
    const roomName = formData.get("roomName")?.toString().trim();
    const rawTipo = formData.get("tipo")?.toString();
    const tipo = rawTipo === "livre" ? "livre" : "restrita";
    const file = formData.get("image") as File | null;

    if (!session || !lider_id) {
        return { error: "Usuário não autenticado." };
    }

    if (!roomName) {
        return { error: "Informe o nome da sala." };
    }

    function validateImageFile(file: File | null) {
        if (!file || file.size === 0) return false;
        const sizeInMB = file.size / 1000000;
        return sizeInMB <= 25 && file.type.includes("image");
    }

    async function createImageFileURL(file: File | null) {
        if (file && validateImageFile(file)) {
            const bytes = await file.arrayBuffer();
            const buffer = Buffer.from(bytes);
            const filePath = path.join(process.cwd(), "public", file.name);
            await writeFile(filePath, buffer);
            return `/${file.name}`;
        }
        return null;
    }

    try {
        const iconeURL = await createImageFileURL(file);

        const valuesData = {
            nome: roomName,
            lider_id: lider_id,
            tipo: tipo,
            icone_url: iconeURL
        };

        const querySala = controller
            .createQueryCommand()
            .insert("salas")
            .values(valuesData)
            .returning("id")
            .resolve();

        const [novaSala] = await controller.runQuery<{ id: string }>(querySala);

        if (novaSala?.id) {
            const queryMembro = controller
                .createQueryCommand()
                .insert("sala_membros")
                .values({
                    id_usuario: lider_id,
                    id_sala: novaSala.id
                })
                .resolve();

            await controller.runQuery(queryMembro);
        }

        revalidatePath("/dashboard");
        revalidatePath("/rooms");

        return { success: true, roomId: novaSala?.id };
    } catch (error) {
        console.error("Erro ao criar sala:", error);
        return { error: "Não foi possível criar a sala." };
    }
}
