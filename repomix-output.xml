'use client'

import createRoom from '@/actions/createRoom'
import joinRoom from '@/actions/joinRoom'
import { Url } from 'next/dist/shared/lib/router/router'
import { useRouter } from 'next/navigation'
import { ChangeEvent, useCallback, useEffect, useId, useState } from 'react'

export default function AddRoomForm({
    visible,
    closeModal,
}: {
    visible: boolean
    closeModal: () => void
}) {
    const router = useRouter()
    const imageInputID = useId()
    const [file, setFile] = useState<File | null>(null)
    const [isRestricted, setIsRestricted] = useState(false)
    const [createErrorMessage, setCreateErrorMessage] = useState<string | null>(null)
    const [isCreatingRoom, setIsCreatingRoom] = useState(false)
    const [joinErrorMessage, setJoinErrorMessage] = useState<string | null>(null)
    const [isJoiningRoom, setIsJoiningRoom] = useState(false)

    function handleImagePick(event: ChangeEvent<HTMLInputElement>) {
        if (event.target.files && event.target.files[0]) {
            const pickedFile = event.target.files[0]
            setFile(pickedFile)
        }
    }

    const handleCloseModal = useCallback(() => {
        setFile(null)
        setCreateErrorMessage(null)
        setJoinErrorMessage(null)
        closeModal()
    }, [closeModal])

    useEffect(() => {
        if (!visible) {
            return
        }

        function handleKeyDown(event: KeyboardEvent) {
            if (event.key === 'Escape' && !isCreatingRoom && !isJoiningRoom) {
                handleCloseModal()
            }
        }

        document.addEventListener('keydown', handleKeyDown)
        return () => {
            document.removeEventListener('keydown', handleKeyDown)
        }
    }, [visible, isCreatingRoom, isJoiningRoom, handleCloseModal])

    async function handleCreateRoomSubmit(formData: FormData) {
        setIsCreatingRoom(true)
        setCreateErrorMessage(null)

        const result = await createRoom(formData)

        setIsCreatingRoom(false)

        if (result?.error) {
            setCreateErrorMessage(result.error)
            return
        }

        if (result?.success) {
            handleCloseModal()
            router.refresh()
        }
    }

    async function handleJoinRoomSubmit(formData: FormData) {
        setIsJoiningRoom(true)
        setJoinErrorMessage(null)

        const result = await joinRoom(formData)

        setIsJoiningRoom(false)

        if (result?.error) {
            setJoinErrorMessage(result.error)
            return
        }

        if (result?.success) {
            handleCloseModal()
            router.refresh()
        }
    }

    if (!visible) {
        return null
    }

    return (
        <div
            className="fixed inset-0 z-60 flex items-center justify-center bg-black/35 p-4"
            onClick={(event) => {
                if (event.target === event.currentTarget && !isCreatingRoom && !isJoiningRoom) {
                    handleCloseModal()
                }
            }}
        >
            <div className="w-fit flex flex-col lg:flex-row gap-5">
                <form
                    action={handleCreateRoomSubmit}
                    className="bg-white w-full max-w-md lg:w-105 lg:h-150 py-6 flex items-center justify-center flex-col gap-5 rounded-xl dark:bg-[#1D1D1D]"
                >
                    <h1 className="text-3xl lg:text-4xl pt-2 text-black dark:text-white">Criar uma sala</h1>
                    <input
                        name="roomName"
                        className="bg-[#E2E2E2] w-2/3 h-14 rounded-lg dark:bg-[#303030] text-black dark:text-white placeholder:text-black/50 dark:placeholder:text-white/65 pl-5 block"
                        placeholder="Nome da sala"
                        required
                    />
                    <input id={imageInputID} className="hidden" name="image" onChange={handleImagePick} type="file" />
                    <input type="hidden" name="tipo" value={isRestricted ? 'restrita' : 'livre'} />

                    <div className="grid grid-cols-3 items-center justify-center w-2/3 text-black dark:text-white">
                        <p className={`${isRestricted ? 'opacity-0' : 'opacity-100'} text-end transition-opacity duration-200 cursor-default select-none`}>
                            Sala Livre
                        </p>
                        <button
                            type="button"
                            role="switch"
                            aria-checked={isRestricted}
                            onClick={() => {
                                setIsRestricted((previous) => !previous)
                            }}
                            className={`relative w-15 h-7.5 ${isRestricted ? 'bg-[#E60000]' : 'bg-[#139C1A]'} rounded-full p-1 flex items-center cursor-pointer select-none justify-self-center`}
                        >
                            <div
                                className={`rounded-full bg-[#E2E2E2] w-6 h-6 transition-transform duration-200 ${
                                    isRestricted ? 'translate-x-7' : 'translate-x-0'
                                }`}
                            ></div>
                        </button>
                        <p className={`${isRestricted ? 'opacity-100' : 'opacity-0'} text-start transition-opacity duration-200 cursor-default select-none`}>
                            Sala Restrita
                        </p>
                    </div>

                    <span className="italic font-light -mt-4 text-center px-4 text-black/75 dark:text-white/75">
                        {!isRestricted
                            ? 'Qualquer membro pode controlar tarefas'
                            : 'Apenas o líder pode controlar tarefas'}
                    </span>

                    <label
                        htmlFor={imageInputID}
                        className="w-50 h-10 text-white bg-blue-500 font-semibold text-center flex justify-center items-center rounded-md cursor-pointer hover:scale-105 duration-100"
                    >
                        Escolha o ícone
                    </label>
                    <label htmlFor={imageInputID} className="cursor-pointer hover:scale-105 duration-100">
                        <ImagePicker file={file as File} />
                    </label>
                    {createErrorMessage && (
                        <p role="alert" className="text-sm text-red-600 dark:text-red-400 text-center px-6">
                            {createErrorMessage}
                        </p>
                    )}
                    <div className="flex gap-5 px-4">
                        <button
                            type="submit"
                            disabled={isCreatingRoom}
                            className="bg-teal-500 px-6 w-36 lg:w-40 py-3 rounded-lg text-white hover:scale-110 duration-200 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                        >
                            {isCreatingRoom ? 'Adicionando...' : 'Adicionar Sala'}
                        </button>
                        <button
                            type="button"
                            onClick={handleCloseModal}
                            disabled={isCreatingRoom}
                            className="border-box bg-teal-500/10 text-center border-2 border-teal-500 px-6 py-3 w-36 lg:w-40 rounded-lg text-black dark:text-white hover:scale-110 duration-200 cursor-pointer disabled:opacity-50"
                        >
                            Sair
                        </button>
                    </div>
                </form>

                <form
                    action={handleJoinRoomSubmit}
                    className="bg-white w-full max-w-md lg:w-105 lg:h-150 py-6 flex items-center justify-center flex-col gap-7 rounded-xl dark:bg-[#1D1D1D]"
                >
                    <h1 className="text-3xl lg:text-4xl pt-2 text-black dark:text-white">Entrar em uma sala</h1>
                    <span className="italic font-light text-center px-8 text-black/75 dark:text-white/75">
                        Insira o ID da sala para participar
                    </span>
                    <input
                        name="roomId"
                        type="text"
                        required
                        pattern="^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                        title="Informe um ID válido (ex: 0195a1b2-c3d4-7e5f-8a9b-0c1d2e3f4a5b)"
                        placeholder="ID da sala"
                        className="bg-[#E2E2E2] w-2/3 h-14 rounded-lg dark:bg-[#303030] text-black dark:text-white placeholder:text-black/50 dark:placeholder:text-white/65 px-5 block"
                    />
                    {joinErrorMessage && (
                        <p role="alert" className="text-sm text-red-600 dark:text-red-400 text-center px-6">
                            {joinErrorMessage}
                        </p>
                    )}
                    <button
                        type="submit"
                        disabled={isJoiningRoom}
                        className="bg-teal-500 px-6 w-48 py-3 rounded-lg text-white hover:scale-110 duration-200 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                    >
                        {isJoiningRoom ? 'Entrando...' : 'Entrar na Sala'}
                    </button>
                </form>
            </div>
        </div>
    )
}

function ImagePicker({ file }: { file: File }) {
    function fileToURL(file: File) {
        const url = URL.createObjectURL(file)
        return url as Url
    }

    if (!!file && file.type.includes('image')) {
        const url = fileToURL(file)
        return (
            <div className="select-none size-48 lg:size-70 border-3 border-white/15 text-9xl text-center flex justify-center items-center rounded-2xl">
                <img src={url.toString()} alt={file.name} className="size-full rounded-2xl object-cover" />
            </div>
        )
    }

    return (
        <div className="select-none size-36 lg:size-48 border-3 border-black/15 dark:border-white/15 text-7xl lg:text-9xl text-center flex justify-center items-center text-black/25 dark:text-white/25 rounded-2xl">
            {' '}
            +{' '}
        </div>
    )
}
