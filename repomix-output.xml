};

export const TASK_COLOR_OPTIONS: ReadonlyArray<TaskColorOption> = [
    { hexCode: "#EF4444", label: "Vermelho" },
    { hexCode: "#F97316", label: "Laranja" },
    { hexCode: "#F59E0B", label: "Âmbar" },
