<file path="components/ProfileSettingsSection.tsx">
"use client";

import {
    updateShowEmail,
    updateUserAvatar,
    updateUsername,
} from "@/actions/updateUserSettings";
import {
    MAX_FONT_SCALE,
    MIN_FONT_SCALE,
    useUserPreferences,
} from "@/components/ThemeProvieder";
import {
    Camera,
    Check,
    Eye,
    EyeOff,
    Loader2,
    Minus,
    Plus,
    Sparkles,
    Type,
} from "lucide-react";
import { useSession } from "next-auth/react";
import Image from "next/image";
import { useRouter } from "next/navigation";
import { ChangeEvent, FormEvent, useEffect, useId, useState } from "react";

type ProfileSettingsSectionProps = {
    initialUsername: string;
    initialImage: string | null;
    initialShowEmail: boolean;
    userEmail: string | null;
};

export default function ProfileSettingsSection({
    initialUsername,
    initialImage,
    initialShowEmail,
    userEmail,
}: ProfileSettingsSectionProps) {
    const { data: session, update: updateSession } = useSession();
    const router = useRouter();
    const avatarInputId = useId();
    const usernameInputId = useId();

    const {
        fontScale,
        increaseFontScale,
        decreaseFontScale,
        resetFontScale,
        reduceMotion,
        setReduceMotion,
    } = useUserPreferences();

    const [draftName, setDraftName] = useState(initialUsername);
    const [showEmail, setShowEmail] = useState(initialShowEmail);
    const [isSavingName, setIsSavingName] = useState(false);
    const [isUploadingAvatar, setIsUploadingAvatar] = useState(false);
    const [isUpdatingEmailVisibility, setIsUpdatingEmailVisibility] = useState(false);
    const [feedbackMessage, setFeedbackMessage] = useState<{
        type: "error" | "success";
        text: string;
    } | null>(null);

    useEffect(() => {
        setDraftName(initialUsername);
    }, [initialUsername]);

    useEffect(() => {
        setShowEmail(initialShowEmail);
    }, [initialShowEmail]);

    const displayedImage = session?.user?.image ?? initialImage;
    const displayedName = session?.user?.name ?? initialUsername;
    const hasNameChanged =
        draftName.trim().length >= 2 && draftName.trim() !== displayedName;

    async function handleAvatarChange(event: ChangeEvent<HTMLInputElement>) {
        const pickedFile = event.target.files?.[0];
        event.target.value = "";

        if (!pickedFile || isUploadingAvatar) {
            return;
        }

        setIsUploadingAvatar(true);
        setFeedbackMessage(null);

        const formData = new FormData();
        formData.set("avatar", pickedFile);

        const result = await updateUserAvatar(formData);
        setIsUploadingAvatar(false);

        if (result.error) {
            setFeedbackMessage({ type: "error", text: result.error });
            return;
        }

        if (result.success) {
            await updateSession({
                name: result.username ?? displayedName,
                image: result.image ?? null,
            });
            setFeedbackMessage({
                type: "success",
                text: "Foto de perfil atualizada!",
            });
            router.refresh();
        }
    }

    async function handleNameSubmit(event: FormEvent<HTMLFormElement>) {
        event.preventDefault();
        if (isSavingName || !hasNameChanged) {
            return;
        }

        const trimmed = draftName.trim();
        setIsSavingName(true);
        setFeedbackMessage(null);

        const result = await updateUsername(trimmed);
        setIsSavingName(false);

        if (result.error) {
            setFeedbackMessage({ type: "error", text: result.error });
            return;
        }

        if (result.success && result.username) {
            await updateSession({
                name: result.username,
                image: result.image ?? displayedImage,
            });
            setFeedbackMessage({
                type: "success",
                text: "Nome de usuário atualizado!",
            });
            router.refresh();
        }
    }

    async function handleToggleShowEmail() {
        if (isUpdatingEmailVisibility) {
            return;
        }

        const nextValue = !showEmail;
        setShowEmail(nextValue);
        setIsUpdatingEmailVisibility(true);
        setFeedbackMessage(null);

        const result = await updateShowEmail(nextValue);
        setIsUpdatingEmailVisibility(false);

        if (result.error) {
            setShowEmail(!nextValue);
            setFeedbackMessage({ type: "error", text: result.error });
            return;
        }

        if (result.success && typeof result.showEmail === "boolean") {
            setShowEmail(result.showEmail);
            setFeedbackMessage({
                type: "success",
                text: result.showEmail
                    ? "Seu e-mail agora está visível no seu perfil."
                    : "Seu e-mail agora está oculto para outros usuários.",
            });
            router.refresh();
        }
    }

    return (
        <section className="flex flex-col gap-3">
            <div>
                <span className="text-xs font-medium text-black/50 dark:text-white/50 uppercase tracking-wide">
                    Conta e Preferências
                </span>
                <h2 className="text-lg font-semibold text-black dark:text-white">
                    Configurações
                </h2>
            </div>

            <div className="bg-[#E2E2E2] dark:bg-[#303030] rounded-2xl p-5 sm:p-6 flex flex-col gap-5">
                {feedbackMessage && (
                    <p
                        role="status"
                        className={`text-xs font-medium rounded-xl px-3.5 py-2.5 ${
                            feedbackMessage.type === "error"
                                ? "bg-red-500/15 text-red-700 dark:text-red-300"
                                : "bg-teal-500/15 text-teal-800 dark:text-teal-200"
                        }`}
                    >
                        {feedbackMessage.text}
                    </p>
                )}

                <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div className="flex items-center gap-3.5 min-w-0">
                        <div className="w-12 h-12 rounded-full bg-black/10 dark:bg-white/15 overflow-hidden flex items-center justify-center shrink-0">
                            {displayedImage ? (
                                <Image
                                    src={displayedImage}
                                    alt={displayedName}
                                    width={48}
                                    height={48}
                                    unoptimized={displayedImage.startsWith("/uploads/")}
                                    className="w-full h-full object-cover"
                                />
                            ) : (
                                <span className="text-base font-semibold text-black dark:text-white">
                                    {displayedName.charAt(0).toUpperCase()}
                                </span>
                            )}
                        </div>
                        <div className="flex flex-col min-w-0">
                            <span className="text-sm font-medium text-black dark:text-white">
                                Foto de perfil
                            </span>
                            <span className="text-xs text-black/55 dark:text-white/55">
                                PNG, JPG, WEBP ou GIF (máx. 5 MB)
                            </span>
                        </div>
                    </div>

                    <div className="shrink-0">
                        <input
                            id={avatarInputId}
                            type="file"
                            accept="image/png,image/jpeg,image/webp,image/gif"
                            onChange={handleAvatarChange}
                            disabled={isUploadingAvatar}
                            className="hidden"
                        />
                        <label
                            htmlFor={avatarInputId}
                            className={`inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold bg-white dark:bg-[#1D1D1D] text-black dark:text-white hover:bg-teal-500 hover:text-white dark:hover:bg-teal-500 transition-colors cursor-pointer ${
                                isUploadingAvatar ? "opacity-60 pointer-events-none" : ""
                            }`}
                        >
                            {isUploadingAvatar ? (
                                <Loader2 className="w-4 h-4 animate-spin" />
                            ) : (
                                <Camera className="w-4 h-4" />
                            )}
                            <span>{isUploadingAvatar ? "Enviando..." : "Alterar foto"}</span>
                        </label>
                    </div>
                </div>


                <form onSubmit={handleNameSubmit} className="flex flex-col gap-2">
                    <label
                        htmlFor={usernameInputId}
                        className="text-sm font-medium text-black dark:text-white"
                    >
                        Nome de usuário
                    </label>
                    <div className="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5">
                        <input
                            id={usernameInputId}
                            type="text"
                            value={draftName}
                            onChange={(e) => setDraftName(e.target.value)}
                            maxLength={128}
                            minLength={2}
                            required
                            disabled={isSavingName}
                            className="flex-1 h-10 rounded-xl bg-white dark:bg-[#1D1D1D] px-3.5 text-sm text-black dark:text-white focus:outline-none focus:ring-2 focus:ring-teal-500"
                        />
                        <button
                            type="submit"
                            disabled={isSavingName || !hasNameChanged}
                            className="h-10 px-4 rounded-xl bg-teal-500 text-white text-xs font-semibold inline-flex items-center justify-center gap-1.5 hover:bg-teal-600 transition-colors cursor-pointer disabled:opacity-45 disabled:cursor-not-allowed shrink-0"
                        >
                            {isSavingName ? (
                                <Loader2 className="w-4 h-4 animate-spin" />
                            ) : (
                                <Check className="w-4 h-4" />
                            )}
                            <span>{isSavingName ? "Salvando..." : "Salvar nome"}</span>
                        </button>
                    </div>
                </form>


                <div className="flex items-center justify-between gap-4">
                    <div className="flex items-start gap-3 min-w-0">
                        {showEmail ? (
                            <Eye className="w-4 h-4 text-teal-600 dark:text-teal-400 shrink-0 mt-0.5" />
                        ) : (
                            <EyeOff className="w-4 h-4 text-black/55 dark:text-white/55 shrink-0 mt-0.5" />
                        )}
                        <div className="flex flex-col min-w-0">
                            <span className="text-sm font-medium text-black dark:text-white">
                                Mostrar e-mail no perfil
                            </span>
                            <span className="text-xs text-black/55 dark:text-white/55">
                                {userEmail
                                    ? showEmail
                                        ? `Visível como ${userEmail}`
                                        : `Oculto (${userEmail} aparece apenas para você)`
                                    : "Define se outros usuários podem ver seu e-mail"}
                            </span>
                        </div>
                    </div>

                    <button
                        type="button"
                        role="switch"
                        aria-checked={showEmail}
                        aria-label="Mostrar e-mail no perfil"
                        disabled={isUpdatingEmailVisibility}
                        onClick={handleToggleShowEmail}
                        className={`relative w-11 h-6 rounded-full p-0.5 transition-colors cursor-pointer shrink-0 disabled:opacity-50 ${
                            showEmail
                                ? "bg-teal-500"
                                : "bg-black/20 dark:bg-[#1D1D1D]"
                        }`}
                    >
                        <span
                            className={`block w-5 h-5 rounded-full bg-white shadow transition-transform ${
                                showEmail ? "translate-x-5" : "translate-x-0"
                            }`}
                        />
                    </button>
                </div>

                <div className="h-px bg-black/10 dark:bg-white/10" />

                <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div className="flex items-center justify-between gap-2 bg-white/70 dark:bg-[#1D1D1D]/70 rounded-xl px-3.5 py-2.5">
                        <div className="flex items-center gap-2 text-black dark:text-white">
                            <Type className="w-4 h-4 text-black/60 dark:text-white/60 shrink-0" />
                            <span className="text-xs font-medium">Tamanho da fonte</span>
                        </div>

                        <div className="flex items-center gap-1 bg-[#E2E2E2] dark:bg-[#303030] rounded-lg p-0.5">
                            <button
                                type="button"
                                onClick={decreaseFontScale}
                                disabled={fontScale <= MIN_FONT_SCALE}
                                aria-label="Diminuir fonte"
                                className="p-1.5 rounded-md text-black dark:text-white hover:bg-white dark:hover:bg-[#1D1D1D] disabled:opacity-35 transition-colors cursor-pointer disabled:cursor-not-allowed"
                            >
                                <Minus className="w-3.5 h-3.5" />
                            </button>
                            <button
                                type="button"
                                onClick={resetFontScale}
                                title="Restaurar tamanho padrão (100%)"
                                className="px-1.5 text-[11px] font-semibold tabular-nums text-black dark:text-white hover:text-teal-600 dark:hover:text-teal-400 cursor-pointer"
                            >
                                {fontScale}%
                            </button>
                            <button
                                type="button"
                                onClick={increaseFontScale}
                                disabled={fontScale >= MAX_FONT_SCALE}
                                aria-label="Aumentar fonte"
                                className="p-1.5 rounded-md text-black dark:text-white hover:bg-white dark:hover:bg-[#1D1D1D] disabled:opacity-35 transition-colors cursor-pointer disabled:cursor-not-allowed"
                            >
                                <Plus className="w-3.5 h-3.5" />
                            </button>
                        </div>
                    </div>

                    <div className="flex items-center justify-between gap-2 bg-white/70 dark:bg-[#1D1D1D]/70 rounded-xl px-3.5 py-2.5">
                        <div className="flex items-center gap-2 text-black dark:text-white">
                            <Sparkles className="w-4 h-4 text-black/60 dark:text-white/60 shrink-0" />
                            <span className="text-xs font-medium">Reduzir animações</span>
                        </div>

                        <button
                            type="button"
                            role="switch"
                            aria-checked={reduceMotion}
                            aria-label="Reduzir animações"
                            onClick={() => setReduceMotion(!reduceMotion)}
                            className={`relative w-10 h-5.5 rounded-full p-0.5 transition-colors cursor-pointer shrink-0 ${
                                reduceMotion
                                    ? "bg-teal-500"
                                    : "bg-[#E2E2E2] dark:bg-[#303030]"
                            }`}
                        >
                            <span
                                className={`block w-4.5 h-4.5 rounded-full bg-white shadow transition-transform ${
                                    reduceMotion ? "translate-x-4.5" : "translate-x-0"
                                }`}
                            />
                        </button>
                    </div>
                </div>
            </div>
        </section>
    );
}
</file>

<file path="components/RoomUpcomingTasksPanel.tsx">
"use client";

import {
  buildCalendarDateString,
  formatRelativeTaskDate,
  RoomTaskItem,
} from "@/lib/tasks";
import { ChevronRight } from "lucide-react";
import { useMemo } from "react";

type RoomUpcomingTasksPanelProps = {
  tasks: RoomTaskItem[];
  onSelectTaskDate: (dateString: string) => void;
};

export default function RoomUpcomingTasksPanel({
  tasks,
  onSelectTaskDate,
}: RoomUpcomingTasksPanelProps) {
  const todayDateString = useMemo(() => {
    const now = new Date();
    return buildCalendarDateString(
      now.getFullYear(),
      now.getMonth(),
      now.getDate(),
    );
  }, []);

  const upcomingTasks = useMemo(() => {
    return tasks
      .filter(
        (taskItem) =>
          !taskItem.concluida && taskItem.dataEntrega >= todayDateString,
      )
      .sort((firstTask, secondTask) =>
        firstTask.dataEntrega.localeCompare(secondTask.dataEntrega),
      );
  }, [tasks, todayDateString]);

  return (
    <aside className="w-full bg-[#F5F5F5] dark:bg-[#252525] rounded-2xl p-4 sm:p-5 flex flex-col gap-4">
      <div className="flex items-center justify-between gap-2">
        <div className="flex items-center gap-2">
          <h2 className="text-base font-semibold text-black dark:text-white">
            Próximas tarefas
          </h2>
          <span className="text-xs px-0.5 py-0.5 rounded-full font-medium">
            ({upcomingTasks.length})
          </span>
        </div>
      </div>

      {upcomingTasks.length > 0 ? (
        <ul className="flex flex-col gap-2.5 max-h-80 overflow-y-auto pr-0.5">
          {upcomingTasks.slice(0, 5).map((taskItem) => {
            const dateInfo = formatRelativeTaskDate(
              taskItem.dataEntrega,
              todayDateString,
            );

            return (
              <li key={taskItem.id}>
                <button
                  type="button"
                  onClick={() => onSelectTaskDate(taskItem.dataEntrega)}
                  className="w-full text-left rounded-xl p-3 bg-white dark:bg-[#1D1D1D] hover:scale-[1.01] hover:bg-black/4 dark:hover:bg-white/4 transition-all duration-150 cursor-pointer flex items-center justify-between gap-3"
                >
                  <div className="flex items-center gap-2.5 min-w-0">
                    <span
                      className="w-2.5 h-2.5 rounded-full shrink-0"
                      style={{
                        backgroundColor: taskItem.cor,
                      }}
                    />
                    <span className="text-sm font-medium text-black dark:text-white truncate">
                      {taskItem.nome}
                    </span>
                  </div>

                  <div className="flex items-center gap-1.5 shrink-0">
                    {taskItem.hasUnreadMessages && (
                      <span
                        title="Mensagens não lidas"
                        aria-label="Mensagens não lidas"
                        className="w-2 h-2 rounded-full bg-[#E60000] shrink-0"
                      />
                    )}
                    <span
                      className={`text-xs font-medium ${
                        dateInfo.isToday
                          ? "text-teal-600 dark:text-teal-400 font-semibold"
                          : "text-black/50 dark:text-white/50"
                      }`}>
                      {dateInfo.label}
                    </span>
                    <ChevronRight className="w-4 h-4 text-black/40 dark:text-white/40" />
                  </div>
                </button>
              </li>
            );
          })}
        </ul>
      ) : (
        <div className="rounded-xl p-4 bg-white/70 dark:bg-[#1D1D1D]/70 text-center">
          <p className="text-xs text-black/55 dark:text-white/55">
            Nada para ver aqui
          </p>
        </div>
      )}
    </aside>
  );
}
</file>

<file path="components/RoomWorkspace.tsx">
"use client";

import Calendar, { CalendarDateJumpRequest } from "@/components/Calendar";
import ChatModal from "@/components/ChatModal";
import RoomMembersPanel, {
    RoomMemberItem,
} from "@/components/RoomMembersPanel";
import RoomUpcomingTasksPanel from "@/components/RoomUpcomingTasksPanel";
import { ChatTarget } from "@/lib/chat";
import { RoomTaskItem } from "@/lib/tasks";
import { ArrowLeft, Crown, Lock, LockOpen, MessageSquare } from "lucide-react";
import Image from "next/image";
import Link from "next/link";
import { useRouter } from "next/navigation";
import { useMemo, useState } from "react";

type RoomWorkspaceProps = {
    roomId: string;
    roomName: string;
    roomIconUrl: string | null;
    roomType: "livre" | "restrita";
    leaderUsername: string;
    tasks: RoomTaskItem[];
    members: RoomMemberItem[];
    currentUserId: string;
    currentUserName: string;
    isRoomLeader: boolean;
    canCreateTasks: boolean;
    canSendMessages: boolean;
};

export default function RoomWorkspace({
    roomId,
    roomName,
    roomIconUrl,
    roomType,
    leaderUsername,
    tasks,
    members,
    currentUserId,
    currentUserName,
    isRoomLeader,
    canCreateTasks,
    canSendMessages,
}: RoomWorkspaceProps) {
    const router = useRouter();
    const [selectedDateString, setSelectedDateString] = useState<string | null>(
        null
    );
    const [navigateToDateRequest, setNavigateToDateRequest] =
        useState<CalendarDateJumpRequest | null>(null);
    const [activeChatTarget, setActiveChatTarget] = useState<ChatTarget | null>(
        null
    );
    const [locallyReadTaskIds, setLocallyReadTaskIds] = useState<string[]>([]);

    const isRestrictedRoom = roomType === "restrita";

    const resolvedTasks = useMemo(() => {
        if (locallyReadTaskIds.length === 0) {
            return tasks;
        }
        const readSet = new Set(locallyReadTaskIds);
        return tasks.map((task) =>
            readSet.has(task.id) ? { ...task, hasUnreadMessages: false } : task
        );
    }, [tasks, locallyReadTaskIds]);

    function handleSelectUpcomingTaskDate(targetDateString: string) {
        setNavigateToDateRequest((previous) => ({
            dateString: targetDateString,
            nonce: (previous?.nonce ?? 0) + 1,
        }));
        setSelectedDateString(targetDateString);
    }

    function handleOpenTaskChat(task: RoomTaskItem) {
        setLocallyReadTaskIds((previous) =>
            previous.includes(task.id) ? previous : [...previous, task.id]
        );
        setActiveChatTarget({
            type: "task",
            roomId,
            taskId: task.id,
            title: task.nome,
            color: task.cor,
        });
    }

    function handleOpenRoomChat() {
        setActiveChatTarget({
            type: "room",
            roomId,
            title: "Chat da Sala",
        });
    }

    function handleCloseChatModal() {
        const wasTaskChat = activeChatTarget?.type === "task";
        setActiveChatTarget(null);
        if (wasTaskChat) {
            router.refresh();
        }
    }

    return (
        <>
            <div>
                <Link
                    href="/rooms"
                    className="inline-flex items-center gap-1.5 text-xs font-medium text-black/50 dark:text-white/50 hover:text-black dark:hover:text-white transition-colors mb-4"
                >
                    <ArrowLeft className="w-3.5 h-3.5" />
                    <span>Voltar</span>
                </Link>

                <div className="flex items-center justify-between gap-4 flex-wrap">
                    <div className="flex items-center gap-4 sm:gap-5 min-w-0">
                        {!roomIconUrl ? (
                            <div className="w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-[#E2E2E2] dark:bg-[#303030] flex items-center justify-center text-3xl sm:text-4xl font-bold text-black dark:text-white shrink-0 shadow-sm">
                                {roomName.charAt(0).toUpperCase()}
                            </div>
                        ) : (
                            <Image
                                width={192}
                                height={192}
                                quality={95}
                                src={roomIconUrl}
                                alt={roomName}
                                className="w-20 h-20 sm:w-24 sm:h-24 rounded-full object-cover shrink-0 shadow-sm"
                            />
                        )}

                        <div className="flex flex-col gap-1 min-w-0">
                            <h1 className="text-2xl sm:text-3xl font-bold text-black dark:text-white truncate">
                                {roomName}
                            </h1>
                            <span className="inline-flex items-center gap-1.5 text-xs sm:text-sm text-black/55 dark:text-white/55">
                                {isRoomLeader && (
                                    <Crown
                                        strokeWidth={1.75}
                                        className="w-3.5 h-3.5 text-black/55 dark:text-white/55"
                                    />
                                )}
                                <span>
                                    {isRoomLeader
                                        ? "Você é o líder desta sala"
                                        : `Líder: ${leaderUsername}`}
                                </span>
                            </span>
                        </div>
                    </div>

                    <div className="flex items-center gap-2.5 flex-wrap shrink-0">
                        <button
                            type="button"
                            onClick={handleOpenRoomChat}
                            className="px-3.5 py-1.5 text-xs font-semibold inline-flex items-center gap-1.5 rounded-full bg-teal-500/15 text-teal-700 dark:bg-teal-400/20 dark:text-teal-300 hover:bg-teal-500/25 dark:hover:bg-teal-400/30 transition-colors cursor-pointer shrink-0"
